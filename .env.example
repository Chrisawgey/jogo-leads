# Copy to .env.local for local dev; set the same vars in Vercel for production.

# The code the team types to get in. Changing it signs everyone out.
LEADS_ACCESS_CODE=

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADS_SESSION_SECRET=

# Firebase service account — same one the admin portal uses.
# Vercel: the whole JSON, base64-encoded
FIREBASE_SERVICE_ACCOUNT_B64=
# Local alternative: individual fields
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional: Google geocoding for "Find on map". Without it, OpenStreetMap is used.
GOOGLE_MAPS_API_KEY=

# Optional but recommended: a separate Firestore database (e.g. "leads") so the
# Jogo app's catch-all read rule can't reach lead data. Create it in the
# Firebase console first.
LEADS_FIRESTORE_DATABASE=
